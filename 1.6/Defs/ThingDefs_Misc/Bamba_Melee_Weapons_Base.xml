<Defs>

	<!-- Standalone melee parents with NO recipeMaker anywhere in the chain.
       Inherits from BaseWeapon (safe) and manually replicates BaseMeleeWeapon +
       BaseMeleeWeapon_Sharp/Blunt + *_Quality fields WITHOUT recipeMaker. -->

	<ThingDef Name="Bamba_BaseMeleeWeapon_Sharp_NoRecipe" Abstract="True" ParentName="BaseWeapon">
		<techLevel>Industrial</techLevel>
		<smeltable>false</smeltable>
		<burnableByRecipe>true</burnableByRecipe>
		<thingCategories>
			<li>WeaponsMelee</li>
		</thingCategories>
		<weaponClasses>
			<li>Melee</li>
			<li>MeleePiercer</li>
		</weaponClasses>
		<relicChance>1</relicChance>
		<inspectorTabs>
			<li>ITab_Art</li>
		</inspectorTabs>
		<tradeTags>
			<li>WeaponMelee</li>
		</tradeTags>
		<comps>
			<li>
				<compClass>CompQuality</compClass>
			</li>
			<li Class="CompProperties_Art">
				<nameMaker>NamerArtWeaponMelee</nameMaker>
				<descriptionMaker>ArtDescription_WeaponMelee</descriptionMaker>
				<minQualityForArtistic>Excellent</minQualityForArtistic>
			</li>
		</comps>
	</ThingDef>

